# =============================================================================
# GameDay Platform - Environment Template
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit a real .env.
# All variables are validated at startup by @platform/config (zod). Missing
# REQUIRED values cause a fast, explicit failure.
#
# Secret values are intentionally left blank here. Obtain them from:
#   - Supabase: Project Settings -> Database / API
#   - Redis:    your managed Redis provider
#   - SportsDataIO / Loop: respective dashboards
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# ---- Supabase / Postgres (REQUIRED) -----------------------------------------
# Pooled connection used by the API (PgBouncer / transaction pooler).
DATABASE_URL=
# Direct (non-pooled) connection used for migrations.
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. NEVER expose to any frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis cache (OPTIONAL — platform degrades gracefully if unset) ---------
REDIS_URL=
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

# ---- Providers (OPTIONAL until enabled) -------------------------------------
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_BASE_URL=https://api.sportsdata.io/v3

# ---- EMG Loop integration (operating layer) ---------------------------------
LOOP_ENABLED=true
LOOP_INGEST_URL=
LOOP_API_KEY=
